{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "powershift",
        "--port",
        "8000",
        "--data-dir",
        ".data"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "backend-fresh",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "powershift",
        "--port",
        "8000",
        "--data-dir",
        ".data-fresh"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1420
    }
  ]
}